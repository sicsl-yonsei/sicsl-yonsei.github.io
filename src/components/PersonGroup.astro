---
import PersonCard from "./PersonCard.astro";
import type { Person } from "../lib/content";

interface Props {
  title: string;
  people: Person[];
  subgroup?: boolean;
}
const { title, people, subgroup = false } = Astro.props;
---

<section class:list={["w-full", subgroup ? "mb-10" : "mb-14"]}>
  {
    subgroup ? (
      <h3 class="mb-6 w-full border-b border-slate-200 pb-2 text-lg font-bold text-primary-800">
        {title}
      </h3>
    ) : (
      <h2 class="mb-8 w-full border-b border-slate-200 pb-2 font-serif text-2xl font-bold text-slate-900">
        {title}
      </h2>
    )
  }
  <div
    class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5"
  >
    {people.map((p) => <PersonCard person={p} />)}
  </div>
</section>

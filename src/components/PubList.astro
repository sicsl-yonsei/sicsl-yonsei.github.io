---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { Publication } from "../lib/content";
import {
  AREA_LABELS,
  authorIsPerson,
  personKey,
  publicationKind,
} from "../lib/content";

interface Props {
  pubs: Publication[];
}
const { pubs } = Astro.props;

// Directory of lab people, for linking author names + mentee headshots.
const people = await getCollection("people");
const dir = people.map((p) => ({
  slug: p.id,
  name: p.data.name,
  headshot: p.data.headshot,
  key: personKey(p.data.name),
}));
const findPerson = (author: string, year: number) =>
  dir.find(
    (d) =>
      authorIsPerson(author, d.key) &&
      (d.slug === "woojun-choi" || year >= 2026),
  ) ?? null;

// Headshots for every lab member on a paper (in the people collection, with a
// headshot), in author order — including the PI on any paper he co-authored.
const labPeopleFor = (p: Publication) => {
  const seen = new Set<string>();
  const out: typeof dir = [];
  for (const a of p.data.authors) {
    const d = findPerson(a, p.data.year);
    if (!d || !d.headshot || seen.has(d.slug)) continue;
    seen.add(d.slug);
    out.push(d);
  }
  return out;
};

const shortName = (name: string) => name.split(",")[0].trim();
const yearGroups = [...new Set(pubs.map((p) => p.data.year))].map((year) => ({
  year,
  pubs: pubs.filter((p) => p.data.year === year),
}));

const kindLabels = {
  journal: "Journal",
  conference: "Conference",
  book: "Book Chapter",
};

const venueBadge = (venue = "") => {
  const acronym = venue.match(/\(([A-Z][A-Z0-9.-]{1,12})\)/)?.[1];
  if (acronym) return acronym;
  if (/bioRxiv/i.test(venue)) return "bioRxiv";
  if (/Journal of Solid-State Circuits/i.test(venue)) return "JSSC";
  if (/Transactions on Circuits and Systems I/i.test(venue)) return "TCAS-I";
  if (/Transactions on Circuits and Systems II/i.test(venue)) return "TCAS-II";
  if (/Solid-State Circuits Letters/i.test(venue)) return "L-SSC";
  if (/Open Journal of Solid-State Circuits/i.test(venue)) return "OJSSCS";
  if (/Springer/i.test(venue)) return "Springer";
  return "";
};

const conferenceTier = (venue = "") => {
  if (/\bISSCC\b|International Solid-State Circuits Conference|\bVLSI\b|Symposium on VLSI/i.test(venue))
    return "Top-tier";
  if (
    /\bCICC\b|Custom Integrated Circuits Conference|\bA[-– ]?SSCC\b|\bASSCC\b|Asian Solid-State Circuits Conference|\bESSCIRC\b|\bESSERC\b|European Solid-State Circuits Conference/i.test(
      venue,
    )
  )
    return "Major";
  return "";
};

const journalTier = (venue = "") => {
  if (/\bJSSC\b|Journal of Solid-State Circuits|\bTCAS[-– ]?I\b|Transactions on Circuits and Systems I(?!I)/i.test(venue))
    return "Top-tier";
  if (
    /\bTCAS[-– ]?II\b|Transactions on Circuits and Systems II|\bL[-– ]?SSC\b|Solid-State Circuits Letters/i.test(
      venue,
    )
  )
    return "Major";
  return "";
};
---

<div id="pub-list" class="space-y-12">
  {
    yearGroups.map((group) => (
      <section data-year-group>
        <h2 class="border-b border-slate-300 pb-3 text-3xl font-bold tracking-tight text-primary-800">
          {group.year}
        </h2>
        <ol class="divide-y divide-slate-100">
          {group.pubs.map((p) => {
      const d = p.data;
      const link = d.doi ? `https://doi.org/${d.doi}` : d.url;
      const search = `${d.title} ${d.authors.join(" ")} ${d.journal ?? ""}`.toLowerCase();
      const stars = new Set(d.equalContributionAuthors);
      const labPeople = labPeopleFor(p);
      const kind = publicationKind(p);
      const venue = venueBadge(d.journal);
      const tier =
        kind === "conference"
          ? conferenceTier(d.journal)
          : kind === "journal"
            ? journalTier(d.journal)
            : "";
      return (
        <li
          class="py-5"
          data-pub
          data-year={d.year}
          data-citations={typeof d.citations === "number" ? d.citations : -1}
          data-kind={kind}
          data-areas={d.areas.join(" ")}
          data-search={search}
        >
          <div class="mb-2 flex flex-wrap items-center gap-2 text-xs">
            {tier && (
              <span
                class:list={[
                  "rounded-full border px-2.5 py-0.5 font-bold",
                  tier === "Top-tier"
                    ? "border-amber-200 bg-amber-100 text-amber-800"
                    : "border-indigo-200 bg-indigo-50 text-indigo-700",
                ]}
              >
                {tier}
              </span>
            )}
            <span class="rounded-full border border-primary-200 bg-primary-50 px-2.5 py-0.5 font-semibold text-primary-700">
              {kindLabels[kind]}
            </span>
            {venue && (
              <span class="rounded-full border border-slate-200 bg-white px-2.5 py-0.5 font-semibold text-slate-700">
                {venue}
              </span>
            )}
            {d.areas
              .filter((area) => area !== "review" && area !== "book-chapter")
              .slice(0, 2)
              .map((area) => (
                <span class="rounded-full bg-accent-50 px-2.5 py-0.5 font-medium text-accent-700">
                  {AREA_LABELS[area]}
                </span>
              ))}
          </div>

          <p class="font-semibold leading-snug text-primary-950">
            {link ? (
              <a
                href={link}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-primary-700 hover:underline hover:underline-offset-2"
              >
                {d.title}
              </a>
            ) : (
              d.title
            )}
          </p>

          <p class="mt-1 text-sm text-slate-600">
            <span class:list={["authors", d.authors.length > 14 && "clamped"]}>
              {d.authors.map((a, i) => {
                const person = findPerson(a, d.year);
                const isPi = person?.slug === "woojun-choi";
                // Only a co-first/-senior (*) marker. Mentees are conveyed by
                // bolded name links + headshots, so they get no marker.
                const mark = stars.has(a) ? "*" : "";
                return (
                  <span class="au">
                    {i > 0 && ", "}
                    {person ? (
                      <a
                        href={`/people/${person.slug}`}
                        class:list={[
                          "font-semibold hover:text-primary-700",
                          isPi
                            ? "text-primary-700 underline decoration-primary-300 underline-offset-2"
                            : "text-slate-900 hover:underline",
                        ]}
                      >
                        {a}
                      </a>
                    ) : (
                      a
                    )}
                    {mark && <sup class="font-semibold text-slate-600">{mark}</sup>}
                  </span>
                );
              })}
            </span>
            {d.authors.length > 14 && (
              <button
                type="button"
                data-authors-toggle
                data-more={`… +${d.authors.length - 12} more`}
                class="ml-1 whitespace-nowrap text-primary-700 hover:underline"
              >
                … +{d.authors.length - 12} more
              </button>
            )}
          </p>

          {d.contributionNote && (
            <p class="mt-1 text-xs italic text-slate-500">
              <sup class="font-semibold">*</sup> {d.contributionNote}
            </p>
          )}

          <p class="mt-0.5 text-sm text-slate-700">
            {d.journal}
          </p>

          {labPeople.length > 0 && (
            <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
              {labPeople.map((m) => (
                <a
                  href={`/people/${m.slug}`}
                  class="group flex items-center gap-2"
                  title={m.name}
                >
                  {m.headshot && (
                    <Image
                      src={m.headshot}
                      alt={m.name}
                      width={64}
                      height={64}
                      class="h-8 w-8 rounded-full object-cover ring-1 ring-slate-200 group-hover:ring-primary-300"
                    />
                  )}
                  <span class="text-xs text-slate-600 group-hover:text-primary-700">
                    {shortName(m.name)}
                  </span>
                </a>
              ))}
            </div>
          )}

          <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
            {typeof d.citations === "number" && (
              <span class="rounded-full bg-amber-100 px-2 py-0.5 font-medium text-amber-800">
                Cited by {d.citations}
              </span>
            )}
            {d.doi && (
              <a
                href={`https://doi.org/${d.doi}`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary-700 hover:underline"
              >
                DOI
              </a>
            )}
            {d.scholarUrl && (
              <a
                href={d.scholarUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary-700 hover:underline"
              >
                Scholar
              </a>
            )}
          </div>
        </li>
      );
          })}
        </ol>
      </section>
    ))
  }
</div>

<script>
  // Expand/collapse clamped author lists.
  document.querySelectorAll<HTMLButtonElement>("[data-authors-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const authors = btn.parentElement?.querySelector(".authors");
      if (!authors) return;
      const clamped = authors.classList.toggle("clamped");
      btn.textContent = clamped ? (btn.dataset.more ?? "more") : "show fewer";
    });
  });
</script>

---
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import type { Person } from "../lib/content";

interface Props {
  person: Person;
}
const { person } = Astro.props;
const { name, role, title, headshot, links } = person.data;

const initials = name
  .split(",")[0]
  .split(/\s+/)
  .map((t) => t[0])
  .filter(Boolean)
  .slice(0, 2)
  .join("")
  .toUpperCase();

type LinkType = "email" | "website" | "scholar" | "orcid" | "twitter" | "linkedin";
const linkItems = [
  links.email && { type: "email", label: "Email", href: `mailto:${links.email}` },
  links.website && { type: "website", label: "Website", href: links.website },
  links.scholar && { type: "scholar", label: "Google Scholar", href: links.scholar },
  links.orcid && { type: "orcid", label: "ORCID", href: links.orcid },
  links.twitter && { type: "twitter", label: "X / Twitter", href: links.twitter },
  links.linkedin && { type: "linkedin", label: "LinkedIn", href: links.linkedin },
].filter(Boolean) as { type: LinkType; label: string; href: string }[];

// Brand glyphs (single-path simple-icons silhouettes). ORCID/LinkedIn/Scholar/X
// carry their brand color; email/website inherit the link text color.
const ICONS: Record<LinkType, { d: string; color?: string }> = {
  email: {
    d: "M1.5 8.67v8.58a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V8.67l-8.928 5.493a3 3 0 0 1-3.144 0L1.5 8.67ZM22.5 6.908V6.75a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3v.158l9.714 5.978a1.5 1.5 0 0 0 1.572 0L22.5 6.908Z",
  },
  website: {
    d: "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 2c.9 0 2.3 1.5 3 4.5H9c.7-3 2.1-4.5 3-4.5ZM4.2 9h3a18 18 0 0 0 0 6h-3a8 8 0 0 1 0-6ZM5 17h2.6c.4 1.4 1 2.6 1.6 3.5A8 8 0 0 1 5 17Zm0-10a8 8 0 0 1 4.2-3.5C8.6 4.4 8 5.6 7.6 7H5Zm7 13.5c-.9 0-2.3-1.5-3-4.5h6c-.7 3-2.1 4.5-3 4.5Zm-3.3-6a16 16 0 0 1 0-6h6.6a16 16 0 0 1 0 6H8.7Zm6.7 5.5c.6-.9 1.2-2.1 1.6-3.5H19a8 8 0 0 1-3.6 3.5ZM16.7 15a18 18 0 0 0 0-6h3a8 8 0 0 1 0 6h-3Zm-.1-8c-.4-1.4-1-2.6-1.6-3.5A8 8 0 0 1 19 7h-2.4Z",
  },
  scholar: {
    d: "M5.242 13.769 0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z",
    color: "#4285F4",
  },
  orcid: {
    d: "M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947 0 .525-.422.947-.947.947-.525 0-.946-.422-.946-.947 0-.516.421-.947.946-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-2.016-1.284-3.722-4.097-3.722h-2.222z",
    color: "#A6CE39",
  },
  twitter: {
    d: "M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z",
    color: "#0f172a",
  },
  linkedin: {
    d: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
    color: "#0A66C2",
  },
};
---

<BaseLayout title={name} description={`${role} — ${name}`}>
  <header class="relative overflow-hidden border-b border-slate-200 bg-gradient-to-br from-white via-white to-primary-50/70">
    <div class="pointer-events-none absolute -top-28 -right-24 h-72 w-72 rounded-full border border-primary-100" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -right-8 bottom-0 h-44 w-44 rounded-full bg-accent-50/60 blur-2xl" aria-hidden="true"></div>
    <div class="container-page relative py-8 sm:py-12">
      <a
        href="/people"
        class="group inline-flex items-center gap-1.5 text-sm font-semibold text-primary-700 transition-colors hover:text-accent-600"
      >
        <span class="transition-transform group-hover:-translate-x-0.5" aria-hidden="true">&larr;</span>
        All people
      </a>
      <div class="mt-7 grid gap-8 sm:grid-cols-[13rem_1fr] sm:items-center lg:gap-12">
        <div class="mx-auto h-64 w-52 overflow-hidden rounded-2xl bg-white shadow-[0_16px_40px_-24px_rgba(15,23,42,0.45)] ring-1 ring-slate-200 sm:mx-0">
          {
            headshot ? (
              <Image
                src={headshot}
                alt={name}
                width={416}
                height={512}
                class="h-full w-full object-cover"
              />
            ) : (
              <div class="flex h-full w-full items-center justify-center bg-primary-100 text-4xl font-semibold text-primary-700">
                {initials}
              </div>
            )
          }
        </div>

        <div>
          <p class="text-xs font-semibold tracking-[0.18em] text-accent-600 uppercase">
            {person.data.group} · SICSL
          </p>
          <div class="mt-4 h-0.5 w-12 rounded-full bg-accent-500"></div>
          <h1 class="mt-4 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">{name}</h1>
          <p class="mt-3 whitespace-pre-line text-lg font-semibold text-primary-700">{role}</p>
          {title && <p class="mt-1 max-w-2xl leading-relaxed text-slate-600">{title}</p>}
          {
            linkItems.length > 0 && (
              <ul class="mt-6 flex flex-wrap items-center gap-2.5">
                {linkItems.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      target={l.href.startsWith("mailto:") ? undefined : "_blank"}
                      rel="noopener noreferrer"
                      class:list={[
                        "inline-flex items-center gap-2 rounded-lg border px-3.5 py-2 text-sm font-semibold shadow-sm transition-colors",
                        l.type === "email"
                          ? "border-primary-800 bg-primary-800 text-white hover:border-primary-700 hover:bg-primary-700"
                          : "border-slate-200 bg-white text-primary-800 hover:border-primary-200 hover:bg-primary-50",
                      ]}
                      title={l.label}
                      aria-label={l.label}
                    >
                      <svg
                        viewBox="0 0 24 24"
                        class="h-5 w-5"
                        fill={ICONS[l.type].color ?? "currentColor"}
                        aria-hidden="true"
                      >
                        <path d={ICONS[l.type].d} />
                      </svg>
                      <span>{l.label}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </div>
    </div>
  </header>

  <div class="container-page py-10 sm:py-14">
    <div class="profile-prose w-full text-slate-700">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .profile-prose :global(> p:first-child) {
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .profile-prose :global(.faculty-intro) {
    max-width: 58rem;
    color: #334155;
    font-size: 1.0625rem;
    line-height: 1.85;
  }

  .profile-prose :global(.faculty-grid) {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  .profile-prose :global(.faculty-card) {
    border: 1px solid #e2e8f0;
    border-radius: 0.9rem;
    background: #fff;
    padding: 1.35rem 1.4rem;
    box-shadow: 0 14px 36px -32px rgba(15, 23, 42, 0.5);
  }

  .profile-prose :global(.faculty-card-wide) {
    grid-column: 1 / -1;
  }

  .profile-prose :global(.faculty-card h2) {
    margin-top: 0;
    border: 0;
    padding-bottom: 0;
    font-size: 1.15rem;
  }

  .profile-prose :global(.faculty-card h2::before) {
    display: inline-block;
    width: 0.25rem;
    height: 1rem;
    margin-right: 0.55rem;
    border-radius: 9999px;
    background: #139fb3;
    content: "";
    vertical-align: -0.08rem;
  }

  .profile-prose :global(.faculty-card ul) {
    margin-top: 0.85rem;
    list-style: none;
    padding-left: 0;
  }

  .profile-prose :global(.faculty-card li) {
    position: relative;
    margin-top: 0.65rem;
    padding-left: 1rem;
  }

  .profile-prose :global(.faculty-card > ul > li::before) {
    position: absolute;
    top: 0.72rem;
    left: 0;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 9999px;
    background: #8ab9dc;
    content: "";
  }

  .profile-prose :global(.faculty-card li > ul) {
    margin-top: 0.3rem;
    padding-left: 0.5rem;
  }

  .profile-prose :global(.faculty-card li > ul > li) {
    margin-top: 0.25rem;
    color: #64748b;
    font-size: 0.875rem;
  }

  .profile-prose :global(.faculty-contact-list > li) {
    margin-top: 0.85rem;
  }

  .profile-prose :global(.faculty-contact-list > li::before) {
    position: absolute;
    top: 0.72rem;
    left: 0;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 9999px;
    background: #8ab9dc;
    content: "";
  }

  .profile-prose :global(.faculty-contact-list p) {
    margin-top: 0;
  }

  .profile-prose :global(.faculty-contact-list li p + p) {
    margin-top: 0.15rem;
  }

  .profile-prose :global(.faculty-contact-heading) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.6rem;
  }

  .profile-prose :global(.faculty-member-badge) {
    display: inline-flex;
    align-items: center;
    min-height: 1.45rem;
    border: 1px solid #99d6df;
    border-radius: 9999px;
    background: #ecfeff;
    padding: 0.1rem 0.55rem;
    color: #0e7490;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.035em;
    line-height: 1;
  }

  .profile-prose :global(.faculty-education-degree),
  .profile-prose :global(.faculty-education-meta) {
    display: block;
  }

  .profile-prose :global(.faculty-education-meta) {
    margin-top: 0.12rem;
  }

  .profile-prose :global(.faculty-education-meta strong),
  .profile-prose :global(.faculty-education-date) {
    white-space: nowrap;
  }

  .profile-prose :global(h2) {
    margin-top: 2.5rem;
    border-bottom: 1px solid #dbe4ee;
    padding-bottom: 0.55rem;
    color: #0b3150;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .profile-prose :global(p) {
    margin-top: 0.75rem;
    line-height: 1.75;
  }

  .profile-prose :global(ul) {
    margin-top: 1rem;
    list-style-type: square;
    padding-left: 1.4rem;
  }

  .profile-prose :global(li) {
    margin-top: 0.65rem;
    padding-left: 0.25rem;
    line-height: 1.7;
  }

  .profile-prose :global(li > ul) {
    margin-top: 0.35rem;
    list-style-type: circle;
  }

  .profile-prose :global(strong) {
    color: #0f172a;
    font-weight: 700;
  }

  .profile-prose :global(a) {
    color: #174e78;
    text-decoration: underline;
    text-decoration-color: #8ab9dc;
    text-underline-offset: 0.15em;
  }

  .profile-prose :global(.award-highlight) {
    color: #dc2626;
    font-style: italic;
    font-weight: 700;
  }

  @media (min-width: 768px) {
    .profile-prose :global(.faculty-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

---
import { publicationKind, type Publication } from "../lib/content";
import {
  conferenceTier,
  journalTier,
  venueBadge,
} from "../lib/publicationLabels";

interface Props {
  pubs: Publication[];
}

const { pubs } = Astro.props;

---

<ol class="divide-y divide-slate-200 overflow-hidden rounded-xl border border-slate-200 bg-white">
  {
    pubs.map((p) => {
      const d = p.data;
      const link = d.doi ? `https://doi.org/${d.doi}` : d.url;
      const venue = venueBadge(d.journal);
      const kind = publicationKind(p);
      const tier =
        kind === "conference"
          ? conferenceTier(d.journal)
          : kind === "journal"
            ? journalTier(d.journal)
            : "";

      return (
        <li class="grid gap-2 px-4 py-3 sm:grid-cols-[4.5rem_1fr] sm:gap-4 sm:px-5">
          <div class="flex flex-wrap items-center gap-1.5 sm:block">
            <span class="text-sm font-bold text-primary-700">{d.year}</span>
            {tier && (
              <span
                class:list={[
                  "rounded-full border px-2 py-0.5 text-[0.7rem] font-bold sm:mt-1 sm:block sm:w-fit",
                  tier === "Top-tier"
                    ? "border-amber-200 bg-amber-100 text-amber-800"
                    : "border-indigo-200 bg-indigo-50 text-indigo-700",
                ]}
              >
                {tier}
              </span>
            )}
            {venue && (
              <span class="rounded-full bg-primary-50 px-2 py-0.5 text-[0.7rem] font-semibold text-primary-700 sm:mt-1 sm:block sm:w-fit">
                {venue}
              </span>
            )}
          </div>
          <div class="min-w-0">
            <p class="text-sm font-semibold leading-snug text-primary-950">
              {link ? (
                <a
                  href={link}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${d.title} (opens in a new tab)`}
                  class="group transition-colors hover:text-primary-700 hover:underline hover:decoration-primary-300 hover:underline-offset-4"
                >
                  {d.title}
                  <span
                    aria-hidden="true"
                    class="ml-1 inline-block text-[0.72em] font-medium text-primary-500 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                  >
                    ↗
                  </span>
                </a>
              ) : (
                d.title
              )}
            </p>
            {d.journal && <p class="mt-1 text-xs leading-relaxed text-slate-500">{d.journal}</p>}
          </div>
        </li>
      );
    })
  }
</ol>

---
import type { Publication } from "../lib/content";

interface Props {
  pubs: Publication[];
}

const { pubs } = Astro.props;

const venueBadge = (venue = "") => {
  const acronym = venue.match(/\(([A-Z][A-Z0-9.-]{1,12})\)/)?.[1];
  if (acronym) return acronym;
  if (/bioRxiv/i.test(venue)) return "bioRxiv";
  if (/Journal of Solid-State Circuits/i.test(venue)) return "JSSC";
  if (/Transactions on Circuits and Systems I/i.test(venue)) return "TCAS-I";
  if (/Transactions on Circuits and Systems II/i.test(venue)) return "TCAS-II";
  if (/Solid-State Circuits Letters/i.test(venue)) return "L-SSC";
  if (/Open Journal of Solid-State Circuits/i.test(venue)) return "OJSSCS";
  return "";
};
---

<ol class="divide-y divide-slate-200 overflow-hidden rounded-xl border border-slate-200 bg-white">
  {
    pubs.map((p) => {
      const d = p.data;
      const link = d.doi ? `https://doi.org/${d.doi}` : d.url;
      const venue = venueBadge(d.journal);

      return (
        <li class="grid gap-2 px-4 py-3 sm:grid-cols-[4.5rem_1fr] sm:gap-4 sm:px-5">
          <div class="flex items-center gap-2 sm:block">
            <span class="text-sm font-bold text-primary-700">{d.year}</span>
            {venue && (
              <span class="rounded-full bg-primary-50 px-2 py-0.5 text-[0.7rem] font-semibold text-primary-700 sm:mt-1 sm:block sm:w-fit">
                {venue}
              </span>
            )}
          </div>
          <div class="min-w-0">
            <p class="text-sm font-semibold leading-snug text-primary-950">
              {link ? (
                <a
                  href={link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-primary-700 hover:underline hover:underline-offset-2"
                >
                  {d.title}
                </a>
              ) : (
                d.title
              )}
            </p>
            {d.journal && <p class="mt-1 text-xs leading-relaxed text-slate-500">{d.journal}</p>}
          </div>
        </li>
      );
    })
  }
</ol>

---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../components/BaseLayout.astro";
import CompactPubList from "../components/CompactPubList.astro";
import PageHeader from "../components/PageHeader.astro";
import { getResearchGroups } from "../lib/content";
import biomedicalInterfaceImage from "../assets/research/biomedical-interface.png";
import displayIcSystemImage from "../assets/research/display-ic-system.png";
import sensorInterfaceImage from "../assets/research/sensor-interface.png";
import sensorPlatformImage from "../assets/research/sensor-platform.png";

// Data-driven: papers group by their `areas` tags. Each area shows its most
// recent few with a link to the full, area-filtered Publications list.
const groups = await getResearchGroups(3);

const researchImages: Record<string, { src: ImageMetadata; alt: string }> = {
  "display-ic": {
    src: displayIcSystemImage,
    alt: "Block diagrams of touch sensor and display driver IC signal chains.",
  },
  "sensor-interface": {
    src: sensorInterfaceImage,
    alt: "Sensor interface signal chain from physical sensing objects through amplification and analog-to-digital conversion.",
  },
  "sensor-platform": {
    src: sensorPlatformImage,
    alt: "Miniaturized sensor system integrating sensing, mixed-signal processing, wireless communication, and energy-efficient computing.",
  },
  biomedical: {
    src: biomedicalInterfaceImage,
    alt: "Capacitive neural interface concept and proposed high-density neural readout system.",
  },
};
---

<BaseLayout
  title="Research"
  description="SICSL research in display ICs, sensor interfaces, miniaturized platforms, and biomedical circuits."
>
  <PageHeader
    eyebrow="What we do"
    title="Research"
  />
  <div class="container-page space-y-16 py-12">
    {
      groups.map((group) => (
        <section class="w-full">
          <div class="mb-3 h-1 w-12 rounded-full bg-accent-500"></div>
          <h2 class="font-serif text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">{group.title}</h2>
          <div class="mt-8 space-y-12">
            {group.areas.map((area) => (
              <div id={area.slug} class="w-full scroll-mt-24">
                <div class="flex w-full flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h3 class="font-serif text-2xl font-semibold text-slate-900">{area.label}</h3>
                  {area.total > area.pubs.length && (
                    <a
                      href={`/publications#${area.slug}`}
                      class="group inline-flex shrink-0 items-center gap-1 text-sm font-medium text-primary-700 transition-colors hover:text-accent-600"
                    >
                      All {area.total}
                      <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">
                        &rarr;
                      </span>
                    </a>
                  )}
                </div>
                <p class="mt-2 w-full text-slate-600">{area.blurb}</p>
                <figure class="mx-auto mt-6 w-full max-w-4xl overflow-hidden rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
                  <Image
                    src={researchImages[area.slug].src}
                    alt={researchImages[area.slug].alt}
                    widths={[640, 960, 1280]}
                    sizes="(min-width: 1024px) 896px, calc(100vw - 3rem)"
                    loading="lazy"
                    class="mx-auto h-auto w-full object-contain"
                  />
                </figure>
                {area.pubs.length > 0 && (
                  <div class="mt-6 w-full">
                    <p class="mb-2 text-xs font-semibold tracking-wide text-slate-500 uppercase">
                      Selected publications
                    </p>
                    <CompactPubList pubs={area.pubs} />
                  </div>
                )}
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

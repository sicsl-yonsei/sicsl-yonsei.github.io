---
import BaseLayout from "../components/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { site } from "../data/site";

const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(site.mapQuery)}&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.mapQuery)}`;
const socials = [
  { label: "Google Scholar", href: site.social.scholar },
  { label: "X / Twitter", href: site.social.twitter },
].filter((s): s is { label: string; href: string } => Boolean(s.href));
---

<BaseLayout
  title="Contact"
  description={`Contact ${site.name} at ${site.institution}.`}
>
  <PageHeader
    eyebrow="Get in touch"
    title="Contact"
  />
  <div class="container-page py-12">
    <div class="grid w-full gap-8 lg:grid-cols-2 lg:items-stretch">
      <div class="rounded-xl border border-slate-200 bg-white p-6">
        <h2 class="font-serif text-xl text-slate-900">{site.shortName}</h2>
        <address class="mt-3 text-slate-600 not-italic">
          {site.address.map((line) => <p>{line}</p>)}
        </address>

        <dl class="mt-6 space-y-2 text-sm">
          <div class="flex gap-2">
            <dt class="font-medium text-slate-600">Email</dt>
            <dd>
              <a
                href={`mailto:${site.email}`}
                class="text-primary-700 hover:underline">{site.email}</a
              >
            </dd>
          </div>
          <div class="flex gap-2">
            <dt class="font-medium text-slate-600">Phone</dt>
            <dd>
              <a
                href={`tel:${site.phone.replace(/[^0-9+]/g, "")}`}
                class="text-primary-700 hover:underline">{site.phone}</a
              >
            </dd>
          </div>
        </dl>

        <h3 class="mt-8 text-sm font-semibold tracking-wide text-slate-600 uppercase">
          Academic Profiles
        </h3>
        <ul class="mt-2 space-y-1 text-sm">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary-700 hover:underline"
                >
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="flex flex-col gap-3">
        <div class="grow overflow-hidden rounded-xl border border-slate-200 shadow-sm">
          <iframe
            title={`Map to ${site.shortName}`}
            src={mapSrc}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="h-80 w-full lg:h-full"></iframe>
        </div>
        <a
          href={mapLink}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-1 self-start text-sm font-medium text-primary-700 transition-colors hover:text-accent-600"
        >
          Open in Google Maps
          <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <section class="mt-12 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="grid lg:grid-cols-[0.78fr_1.5fr]">
        <div class="bg-primary-950 p-7 text-white sm:p-9">
          <p class="text-xs font-bold tracking-[0.18em] text-cyan-300 uppercase">
            Graduate Student Recruitment
          </p>
          <h2 class="mt-4 font-serif text-3xl leading-tight">
            We are looking for passionate researchers.
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-slate-300">
            Applications and brief inquiries about M.S. and Ph.D. opportunities are welcome.
          </p>
          <a
            href={`mailto:${site.email}`}
            class="mt-7 inline-flex items-center gap-2 rounded-lg bg-white px-4 py-2.5 text-sm font-bold text-primary-950 transition hover:bg-cyan-50"
          >
            Contact us
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="p-7 sm:p-9">
          <div class="space-y-3 text-sm leading-relaxed text-slate-700">
            <p>연세대학교 스마트 인터페이스 IC 시스템 연구실에서는 디스플레이 IC 시스템, 센서 인터페이스, 데이터 컨버터(ADC/DAC), 지능형 바이오메디컬 시스템 및 브레인–머신 인터페이스 분야의 대학원생을 모집하고 있습니다.</p>
            <p>관심 있는 학생은 이력서(CV), 자기소개서(희망 연구 분야 포함), 성적표를 <a href={`mailto:${site.email}`} class="font-semibold text-primary-700 hover:underline">{site.email}</a>로 보내주시기 바랍니다. 연구 분야에 대한 간단한 문의도 환영합니다.</p>
          </div>

          <div class="mt-5 border-t border-slate-200 pt-5 text-sm leading-relaxed text-slate-600">
            <p>SICSL at Yonsei University is recruiting graduate students interested in display IC systems, sensor interfaces, data converters (ADCs/DACs), intelligent biomedical systems, and brain–machine interfaces.</p>
            <p class="mt-3">Prospective students are invited to send a CV, statement of purpose (including intended research interests), and academic transcript to <a href={`mailto:${site.email}`} class="font-semibold text-primary-700 hover:underline">{site.email}</a>. Brief inquiries about research opportunities are also welcome.</p>
          </div>

          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href="https://dis.yonsei.ac.kr/"
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-semibold text-primary-700 transition hover:border-primary-300 hover:bg-primary-50"
            >
              디스플레이융합공학과 &rarr;
            </a>
            <a
              href="https://displai.yonsei.ac.kr/"
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-semibold text-primary-700 transition hover:border-primary-300 hover:bg-primary-50"
            >
              지능형디스플레이공학과 &rarr;
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

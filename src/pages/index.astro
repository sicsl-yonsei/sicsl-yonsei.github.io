---
import BaseLayout from "../components/BaseLayout.astro";
import PubList from "../components/PubList.astro";
import { site } from "../data/site";
import { getPublications } from "../lib/content";

const pubs = await getPublications();
const recent = pubs.slice(0, 5);

const themes = [
  {
    title: "Next-Generation Display IC Systems",
    href: "/research#display-ic",
    body: "Scalable analog signal processing for TDDI, micro-LED, quantum-dot, and emerging display platforms.",
  },
  {
    title: "Energy-Efficient Sensor Interfaces",
    href: "/research#sensor-interface",
    body: "Low-power front ends and data converters for light, temperature, impedance, pressure, and other physical signals.",
  },
  {
    title: "Miniaturized Sensor Platforms",
    href: "/research#sensor-platform",
    body: "Highly integrated sensing nodes combining interfaces, memory, control, power, and clock generation.",
  },
  {
    title: "Biomedical Circuits and Systems",
    href: "/research#biomedical",
    body: "High-density, ultra-low-power neural and bioimpedance interfaces for flexible and implantable devices.",
  },
];

const news = [
  { date: "2026.08", text: "Two of our papers on a compact BJT-based temperature sensor and a high-frame-rate SPAD dToF LiDAR sensor were accepted to the 2026 IEEE Asian Solid-State Circuits Conference.", kind: "publication" },
  { date: "2026.07", text: "Chaemin joins SICSL at Yonsei. Welcome!", kind: "people" },
  { date: "2026.04", text: "Yunseong joins SICSL at Yonsei. Welcome!", kind: "people" },
  { date: "2026.03", text: "Our work on a noise-efficient in-vitro and in-vivo capacitive neural interface was accepted to the IEEE Symposium on VLSI Technology and Circuits.", kind: "publication" },
  { date: "2026.02", text: "Kyunghyun joins SICSL at Yonsei. Welcome!", kind: "people" },
  { date: "2026.01", text: "Our collaborative work on analog in-memory computing was accepted to the IEEE Custom Integrated Circuits Conference.", kind: "publication" },
  { date: "2026.01", text: "Ain joins SICSL at Yonsei. Welcome!", kind: "people" },
  { date: "2025.11", text: "Our paper on energy-efficient and temperature-resilient sensor interfaces was accepted to the IEEE Open Journal of the Solid-State Circuits Society.", kind: "publication" },
  { date: "2025.08", text: "Suho joins SICSL at Yonsei. Welcome!", kind: "people" },
  { date: "2025.05", text: "Sun-Woong joins SICSL at Yonsei. Welcome!", kind: "people" },
  { date: "2025.03", text: "Jihoon joins SICSL at Yonsei. Welcome!", kind: "people" },
];
---

<BaseLayout>
  <section
    class="relative overflow-hidden border-b border-slate-800 bg-[#041326] bg-[url('/images/hero-interface-ic.webp')] bg-[length:auto_72%] bg-[position:74%_center] bg-no-repeat text-white sm:bg-[length:auto_90%] sm:bg-[position:right_center]"
  >
    <div
      class="absolute inset-0"
      style="background: linear-gradient(90deg, rgba(2, 12, 27, 0.34) 0%, rgba(2, 12, 27, 0.16) 46%, rgba(2, 12, 27, 0.03) 72%, transparent 100%);"
      aria-hidden="true"
    ></div>
    <div class="container-page relative py-12 sm:py-16">
      <p class="text-sm font-semibold tracking-[0.2em] text-cyan-300 uppercase">
        {site.institution} · {site.university}
      </p>
      <h1 class="mt-5 max-w-5xl font-serif text-4xl leading-tight text-white sm:text-6xl">
        Smart Interface IC<br class="hidden sm:block" /> and Systems Laboratory
      </h1>
      <p class="mt-6 max-w-5xl text-lg leading-relaxed text-slate-200 sm:text-xl">
        {site.description}
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/research" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-primary-950 transition hover:bg-slate-100">Explore our research</a>
        <a href="/people" class="rounded-md border border-white/70 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10">Meet the team</a>
        <a href="mailto:wjchoi11@yonsei.ac.kr" class="rounded-md border border-cyan-300/80 px-5 py-3 text-sm font-semibold text-cyan-200 transition hover:bg-cyan-300/10">Join SICSL</a>
      </div>
    </div>
  </section>

  <section class="border-b border-primary-800 bg-primary-950 text-white">
    <div class="container-page flex flex-col gap-3 py-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-3">
        <svg class="h-6 w-6 shrink-0 text-cyan-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="m3 9 9-4 9 4-9 4-9-4Z"></path>
          <path d="M7 11v4.5c2.8 2 7.2 2 10 0V11"></path>
        </svg>
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h2 class="text-sm font-bold tracking-wide text-cyan-200">Graduate Student Recruitment</h2>
          <p class="text-sm text-slate-300">M.S. and Ph.D. applicants interested in IC design are welcome.</p>
        </div>
      </div>
      <a href="/contact" class="inline-flex shrink-0 items-center gap-2 text-sm font-semibold text-white hover:text-cyan-200">Learn more <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section id="news" class="border-b border-slate-200 bg-white">
    <div class="container-page py-12">
      <div class="grid gap-10 xl:grid-cols-[minmax(0,0.9fr)_minmax(0,1.7fr)_minmax(17rem,1fr)] xl:gap-8">
        <section aria-labelledby="news-heading">
          <div class="mb-5 h-0.5 w-10 rounded-full bg-accent-500"></div>
          <h2 id="news-heading" class="font-serif text-2xl text-slate-900">News</h2>
          <ol class="mt-5 divide-y divide-slate-200 border-y border-slate-200">
            {news.slice(0, 3).map((item) => (
              <li class="py-4">
                <time class="text-xs font-bold tracking-wide text-primary-700">{item.date}</time>
                <p class:list={[
                  "mt-1 text-sm leading-relaxed",
                  item.kind === "publication" ? "font-semibold text-red-700" : "text-slate-700",
                ]}>
                  {item.text}
                </p>
              </li>
            ))}
          </ol>
          <details class="group mt-4 text-sm">
            <summary class="cursor-pointer list-none font-semibold text-primary-700 hover:text-accent-700">More news <span class="inline-block transition group-open:rotate-90">→</span></summary>
            <ol class="mt-3 divide-y divide-slate-100 border-t border-slate-200">
              {news.slice(3).map((item) => (
                <li class="py-3">
                  <time class="text-xs font-bold text-primary-700">{item.date}</time>
                  <p class:list={[
                    "mt-1 text-sm leading-relaxed",
                    item.kind === "publication" ? "font-semibold text-red-700" : "text-slate-700",
                  ]}>{item.text}</p>
                </li>
              ))}
            </ol>
          </details>
        </section>

        <section aria-labelledby="research-heading">
          <div class="mb-5 h-0.5 w-10 rounded-full bg-accent-500"></div>
          <div class="flex items-end justify-between gap-4">
            <h2 id="research-heading" class="font-serif text-2xl text-slate-900">Research areas</h2>
            <a href="/research" class="text-xs font-semibold text-primary-700 hover:text-accent-700">View all →</a>
          </div>
          <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4 xl:grid-cols-2 2xl:grid-cols-4">
            {themes.map((theme, index) => (
              <a href={theme.href} class="group flex min-h-40 flex-col rounded-xl border border-slate-200 bg-slate-50/70 p-4 transition hover:-translate-y-0.5 hover:border-primary-300 hover:bg-white hover:shadow-md">
                <span class="text-xs font-bold tracking-widest text-accent-700">0{index + 1}</span>
                <h3 class="mt-auto pt-8 text-base font-bold leading-snug text-slate-900 group-hover:text-primary-700">{theme.title}</h3>
              </a>
            ))}
          </div>
        </section>

        <section aria-labelledby="visitors-heading">
          <div class="mb-5 h-0.5 w-10 rounded-full bg-accent-500"></div>
          <h2 id="visitors-heading" class="font-serif text-2xl text-slate-900">Visitors</h2>
          <div class="relative mt-5 overflow-hidden rounded-xl border border-slate-200 bg-slate-50 p-5 shadow-sm">
            <div class="absolute -right-12 -top-12 h-40 w-40 rounded-full border border-cyan-200/70" aria-hidden="true"></div>
            <div class="absolute -right-5 -top-5 h-24 w-24 rounded-full border border-primary-200/70" aria-hidden="true"></div>
            <svg class="relative h-12 w-12 text-primary-800" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="24" cy="24" r="20"></circle>
              <path d="M4 24h40M24 4c6 5.5 9 12.2 9 20s-3 14.5-9 20c-6-5.5-9-12.2-9-20S18 9.5 24 4Z"></path>
              <path d="M8.5 13.5h31M8.5 34.5h31"></path>
            </svg>
            <p class="relative mt-5 text-xs font-semibold tracking-widest text-accent-700 uppercase">Website visits</p>
            <img
              src="https://hits.sh/sicsl-yonsei.github.io.svg?style=flat-square&label=Total%20visits&color=0e7490&labelColor=0f172a"
              alt="Total visits to the SICSL website"
              class="relative mt-3 h-7 max-w-full"
              loading="eager"
              referrerpolicy="no-referrer"
            />
            <p class="relative mt-4 text-xs leading-relaxed text-slate-500">The counter records page views from the date this section was added.</p>
          </div>
        </section>
      </div>
    </div>
  </section>

  {recent.length > 0 && (
    <section class="container-page py-16">
      <div class="mb-6 flex items-end justify-between gap-4">
        <div>
          <div class="mb-3 h-0.5 w-10 rounded-full bg-accent-500"></div>
          <h2 class="font-serif text-3xl text-slate-900">Recent publications</h2>
        </div>
        <a href="/publications" class="text-sm font-medium text-primary-700 hover:text-accent-700">All publications →</a>
      </div>
      <PubList pubs={recent} />
    </section>
  )}
</BaseLayout>

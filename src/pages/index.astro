---
import BaseLayout from "../components/BaseLayout.astro";
import PubList from "../components/PubList.astro";
import { site } from "../data/site";
import { getPublications } from "../lib/content";

const pubs = await getPublications();
const recent = pubs.slice(0, 5);

const themes = [
  {
    title: "Next-Generation Display IC Systems",
    href: "/research#display-ic",
    body: "Scalable analog signal processing for TDDI, micro-LED, quantum-dot, and emerging display platforms.",
  },
  {
    title: "Energy-Efficient Sensor Interfaces",
    href: "/research#sensor-interface",
    body: "Low-power front ends and data converters for light, temperature, impedance, pressure, and other physical signals.",
  },
  {
    title: "Miniaturized Sensor Platforms",
    href: "/research#sensor-platform",
    body: "Highly integrated sensing nodes combining interfaces, memory, control, power, and clock generation.",
  },
  {
    title: "Biomedical Circuits and Systems",
    href: "/research#biomedical",
    body: "High-density, ultra-low-power neural and bioimpedance interfaces for flexible and implantable devices.",
  },
];

const news = [
  { date: "2026.08", text: "Two of our papers on a compact BJT-based temperature sensor and a high-frame-rate SPAD dToF LiDAR sensor were accepted to IEEE A-SSCC 2026.", color: "text-red-700" },
  { date: "2026.07", text: "Chaemin joins SICSL at Yonsei. Welcome!" },
  { date: "2026.04", text: "Yunseong joins SICSL at Yonsei. Welcome!" },
  { date: "2026.03", text: "Our work on a noise-efficient in-vitro and in-vivo capacitive neural interface was accepted to IEEE Symposium on VLSI Technology and Circuits.", color: "text-red-700"},
  { date: "2026.02", text: "Kyunghyun joins SICSL at Yonsei. Welcome!" },
  { date: "2026.01", text: "Our collaborative work on analog in-memory computing was accepted to IEEE CICC.", color: "text-red-700"},
  { date: "2026.01", text: "Ain joins SICSL at Yonsei. Welcome!" },
  { date: "2025.11", text: "Our paper on energy-efficient and temperature-resilient sensor interfaces was accepted to IEEE OJSSCS.", color: "text-red-700"},
  { date: "2025.08", text: "Suho joins SICSL at Yonsei. Welcome!" },
  { date: "2025.05", text: "Sun-Woong joins SICSL at Yonsei. Welcome!" },
  { date: "2025.03", text: "Jihoon joins SICSL at Yonsei. Welcome!" },
];
---

<BaseLayout>
  <section
    class="relative overflow-hidden border-b border-slate-800 bg-slate-950 bg-cover bg-[position:68%_center] text-white sm:bg-center"
    style="background-image: url('/images/hero-interface-ic.webp');"
  >
    <div
      class="absolute inset-0"
      style="background: linear-gradient(90deg, rgba(2, 12, 27, 0.97) 0%, rgba(2, 12, 27, 0.9) 45%, rgba(2, 12, 27, 0.46) 74%, rgba(2, 12, 27, 0.18) 100%);"
      aria-hidden="true"
    ></div>
    <div class="container-page relative py-12 sm:py-16">
      <p class="text-sm font-semibold tracking-[0.2em] text-cyan-300 uppercase">
        {site.institution} · {site.university}
      </p>
      <h1 class="mt-5 max-w-5xl font-serif text-4xl leading-tight text-white sm:text-6xl">
        Smart Interface IC<br class="hidden sm:block" /> and Systems Laboratory
      </h1>
      <p class="mt-6 max-w-5xl text-lg leading-relaxed text-slate-200 sm:text-xl">
        {site.description}
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/research" class="rounded-md bg-white px-5 py-3 text-sm font-semibold text-primary-950 transition hover:bg-slate-100">Explore our research</a>
        <a href="/people" class="rounded-md border border-white/70 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/10">Meet the team</a>
        <a href="mailto:wjchoi11@yonsei.ac.kr" class="rounded-md border border-cyan-300/80 px-5 py-3 text-sm font-semibold text-cyan-200 transition hover:bg-cyan-300/10">Join SICSL</a>
      </div>
    </div>
  </section>

  <section class="border-b border-slate-200 bg-white">
    <div class="container-page py-10">
      <div class="grid gap-6 lg:grid-cols-[1fr_2fr] lg:items-start">
        <div>
          <p class="text-xs font-semibold tracking-widest text-accent-700 uppercase">Graduate student recruitment</p>
          <h2 class="mt-2 font-serif text-2xl text-primary-950">We are looking for passionate researchers.</h2>
        </div>
        <div class="space-y-3 text-sm leading-relaxed text-slate-700">
          <p>연세대학교 스마트 인터페이스 IC 시스템 연구실에서는 디스플레이 IC 시스템, 센서 인터페이스, 데이터 컨버터(ADC/DAC), 지능형 바이오메디컬 시스템 및 브레인–머신 인터페이스 분야의 대학원생을 모집하고 있습니다.</p>
          <p>관심 있는 학생은 이력서(CV), 자기소개서(희망 연구 분야 포함), 성적표를 <a href="mailto:wjchoi11@yonsei.ac.kr" class="font-medium text-primary-700 hover:underline">wjchoi11@yonsei.ac.kr</a>로 보내주시기 바랍니다. 연구 분야에 대한 간단한 문의도 환영합니다.</p>
          <p class="flex flex-wrap gap-x-4 gap-y-1">
            <a href="https://dis.yonsei.ac.kr/" target="_blank" rel="noopener noreferrer" class="font-medium text-primary-700 hover:underline">디스플레이융합공학과 →</a>
            <a href="https://displai.yonsei.ac.kr/" target="_blank" rel="noopener noreferrer" class="font-medium text-primary-700 hover:underline">지능형디스플레이공학과 →</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="container-page py-16">
    <div class="mb-3 h-0.5 w-10 rounded-full bg-accent-500"></div>
    <div class="mb-8 flex items-end justify-between gap-4">
      <h2 class="font-serif text-3xl text-slate-900">Research areas</h2>
      <a href="/research" class="text-sm font-medium text-primary-700 hover:text-accent-700">View all research →</a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {themes.map((theme, index) => (
        <a href={theme.href} class="group rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-primary-300 hover:shadow-md">
          <span class="text-xs font-semibold tracking-widest text-accent-700">0{index + 1}</span>
          <h3 class="mt-4 font-serif text-xl leading-snug text-slate-900 group-hover:text-primary-700">{theme.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">{theme.body}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white">
    <div class="container-page grid gap-12 py-16 lg:grid-cols-[1fr_1.4fr]">
      <div>
        <div class="mb-3 h-0.5 w-10 rounded-full bg-accent-500"></div>
        <h2 class="font-serif text-3xl text-slate-900">News</h2>
        <p class="mt-3 max-w-md text-slate-600">Recent publications, new members, and updates from SICSL.</p>
      </div>
      <ol class="divide-y divide-slate-200 border-t border-slate-300">
        {news.map((item) => (
          <li class="grid gap-2 py-4 sm:grid-cols-[5rem_1fr]">
            <time class="text-sm font-semibold text-primary-700">{item.date}</time>
            <p class:list={["text-sm leading-relaxed",item.color ?? "text-slate-700",]}>{item.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {recent.length > 0 && (
    <section class="container-page py-16">
      <div class="mb-6 flex items-end justify-between gap-4">
        <div>
          <div class="mb-3 h-0.5 w-10 rounded-full bg-accent-500"></div>
          <h2 class="font-serif text-3xl text-slate-900">Recent publications</h2>
        </div>
        <a href="/publications" class="text-sm font-medium text-primary-700 hover:text-accent-700">All publications →</a>
      </div>
      <PubList pubs={recent} />
    </section>
  )}
</BaseLayout>
